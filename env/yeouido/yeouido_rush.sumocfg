<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="yeouido.net.xml" />
    <route-files value="yeouido.vtypes.xml,rush.rou.xml" />
    <additional-files value="signals_rush.add.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="4200" />
  </time>
  <processing>
    <time-to-teleport value="300" />
    <ignore-route-errors value="true" />
  </processing>
  <random_number>
    <seed value="42" />
  </random_number>
</configuration>