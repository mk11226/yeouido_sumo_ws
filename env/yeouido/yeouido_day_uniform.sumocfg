<configuration>
    <input>
        <net-file value="yeouido.net.xml"/>
        <route-files value="yeouido.vtypes.xml,day_uniform.rou.xml"/>
        <additional-files value="signals_day.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="4200"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>

        <ignore-route-errors value="true"/>
    </processing>
    <random_number>
        <seed value="7"/>
    </random_number>
</configuration>
