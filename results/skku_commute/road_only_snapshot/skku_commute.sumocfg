<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="skku_commute.net.xml" />
    <route-files value="skku_commute.rou.xml" />
    <additional-files value="campuses.add.xml" />
  </input>
  <time>
    <step-length value="0.5" />
    <end value="7200" />
  </time>
  <processing>
    <time-to-teleport value="-1" />
    <collision.action value="remove" />
    <collision.check-junctions value="true" />
  </processing>
  <report>
    <no-step-log value="true" />
  </report>
  <gui_only>
    <gui-settings-file value="gui.view.xml" />
  </gui_only>
</configuration>